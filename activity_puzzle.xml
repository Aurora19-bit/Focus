<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#131B2E"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anti-Distraction Challenge"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solve this arithmetic equation to earn a 2-minute pass."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/tvEquation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="28 × 16 - 35 = ?"
        android:textColor="#10B981"
        android:textSize="26sp"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:hint="Enter numeric answer"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:inputType="numberSigned" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Submit &amp; Get 2-Min Pass" />
</LinearLayout>